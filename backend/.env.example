# Backend runtime secrets — configure these in Vercel, never commit their values.
MONGODB_URI=mongodb+srv://...
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Keep false in production; supervisors should be provisioned by an administrator.
ALLOW_PUBLIC_SUPERVISOR_REGISTRATION=false
GEMINI_API_KEY=your-gemini-api-key
# Use a model available to this API key. This default supports the grounded
# integrity workflow used by the application.
GEMINI_MODEL=gemini-3.6-flash
# Optional but recommended free OpenAlex API key for literature search.
# Crossref remains available if this is not set.
OPENALEX_API_KEY=your-openalex-api-key
# Optional contact address sent to literature providers as a polite API client.
RESEARCH_CONTACT_EMAIL=research-admin@your-domain.example
# Comma-separated exact allowed frontend origins. Add every production or
# preview URL that should be permitted; wildcard origins are not accepted.
FRONTEND_URL=https://your-frontend.vercel.app
# Account recovery email. Choose either Resend OR SMTP/Gmail. Registration is
# immediate; these values are used only for one-hour password-reset links.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=SuperVisorAI <noreply@your-domain.example>
# Gmail alternative: enable two-step verification on the account, create a
# Google App Password, and use that 16-character value (not the normal password).
# GMAIL_USER=suprevisorassistant@gmail.com
# GMAIL_APP_PASSWORD=your-16-character-google-app-password
# Generic SMTP alternative:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=suprevisorassistant@gmail.com
# SMTP_PASS=your-smtp-password
# Optional explicit frontend origin used in reset links. Otherwise the first
# FRONTEND_URL entry is used.
# PASSWORD_RESET_URL=https://your-frontend.vercel.app
SUPPORT_EMAIL=suprevisorassistant@gmail.com

# Google Identity Services: create a Web application OAuth client in Google
# Cloud Console and enter its *client ID* here (not its client secret). The
# frontend must initialize Google Sign-In with this exact same client ID.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Optional extra comma-separated web client IDs during a controlled migration.
# GOOGLE_CLIENT_IDS=another-client-id.apps.googleusercontent.com
# A short-lived one-time token protects the post-Google profile form.
GOOGLE_PROFILE_TOKEN_EXPIRES_MINUTES=15

# Local-only admin bootstrap: set this temporarily in your terminal before
# running `npm run create-admin -- "Admin Name" admin@example.edu`. Never add
# this value to frontend variables or commit it to an .env file.
# ADMIN_INITIAL_PASSWORD=use-a-unique-12-plus-character-password
# HTTPS /compile endpoint for the separate isolated TeX compiler. Do not point
# this at the frontend, the Vercel API itself, or the compiler's /health route.
LATEX_COMPILER_URL=https://your-latex-compiler.example.com/compile
# Use the same 32+-character random value in the compiler service environment.
LATEX_COMPILER_SHARED_SECRET=replace-with-a-different-long-random-secret
# Optional authenticated gateway in front of a private, self-hosted Piston
# runner. See ../code-runner; never point this at a public execution API.
CODE_RUNNER_URL=https://your-isolated-code-runner.example.com/execute
# Must exactly match RUNNER_SHARED_SECRET on the authenticated runner gateway.
CODE_RUNNER_SHARED_SECRET=replace-with-a-third-long-random-secret
# Optional exact subset installed by the approved runner. When omitted, the
# IDE allows its full fixed list and the runner reports missing runtimes.
CODE_RUNNER_LANGUAGES=javascript,typescript,python,java,c,cpp,csharp,go,rust,r,julia,php,ruby,sql,bash
