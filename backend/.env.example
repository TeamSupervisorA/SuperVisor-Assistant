# Backend runtime secrets — configure these in Vercel, never commit their values.
MONGODB_URI=mongodb+srv://...
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Keep false in production; supervisors should be provisioned by an administrator.
ALLOW_PUBLIC_SUPERVISOR_REGISTRATION=false
GEMINI_API_KEY=optional-gemini-key
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated allowed frontend origins; Vercel previews are also permitted.
FRONTEND_URL=https://your-frontend.vercel.app
# HTTPS endpoint for the separate isolated TeX compiler. Do not point this at
# the frontend or the Vercel API itself.
LATEX_COMPILER_URL=https://your-latex-compiler.example.com/compile
# Use the same long random value in the compiler service environment.
LATEX_COMPILER_SHARED_SECRET=replace-with-a-different-long-random-secret
