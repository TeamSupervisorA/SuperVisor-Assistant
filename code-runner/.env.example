NODE_ENV=production
PORT=8080
# At least 32 random characters. Must exactly match CODE_RUNNER_SHARED_SECRET
# in the backend Vercel project.
RUNNER_SHARED_SECRET=replace-with-a-long-random-secret
# Private/internal Piston execution endpoint. It may use HTTP only when it is
# on a private container network; do not expose Piston directly to the public.
PISTON_URL=http://piston:2000/api/v2/execute
