# Public URL of the separately deployed backend. Do not add a trailing slash.
VITE_API_URL=https://your-backend.vercel.app

# Google OAuth browser client ID. This is a public identifier, not a client
# secret. Create a Web application OAuth client in Google Cloud Console and add
# the deployed frontend URL under Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
